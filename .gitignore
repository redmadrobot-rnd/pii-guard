# ── Model weights must never enter git ────────────────────────────
# 700 MB committed once cannot be removed without rewriting history.
models/*
!models/README.md
*.safetensors
*.bin
*.pt
*.pth
*.onnx
*.gguf

# ── Python ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# ── Tooling caches ────────────────────────────────────────────────
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ── Environment ───────────────────────────────────────────────────
.env
.env.*

# ── Quality dataset must never enter git ──────────────────────────
# It contains real personal data. Same reasoning as the weights above: once
# committed it cannot be removed without rewriting history. The runner reads it
# from disk, so keeping it untracked costs nothing.
tests/quality/test_data/*.xlsx
tests/quality/test_data/*.csv

# ── Quality-gate artefacts (regenerated by a run) ─────────────────
tests/quality/reports/
tests/quality/**/reports/
tests/quality/**/*.bak
tests/quality/**/*.bak_*

# ── Local compose override ────────────────────────────────────────
docker-compose.override.yml

# ── macOS ─────────────────────────────────────────────────────────
.DS_Store
